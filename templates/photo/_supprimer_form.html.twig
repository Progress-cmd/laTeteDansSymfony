<form method="post" action="{{ path('app_supprimer_photos', {'id': photo.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer {{ photo.nomFichier|e('js') }} ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ photo.id) }}">
    <button class="btn-outline theme-danger">Supprimer</button>
</form>
