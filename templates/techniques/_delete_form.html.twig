<form method="post" action="{{ path('app_supprimer_techniques', {'id': technique.id}) }}" onsubmit="return confirm('Êtes vous sûr de vouloir suppirmer {{ technique.nom }} ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ technique.id) }}">
    <button class="btn">Supprimer</button>
</form>
