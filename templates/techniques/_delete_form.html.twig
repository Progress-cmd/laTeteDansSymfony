<form method="post" action="{{ path('app_supprimer_techniques', {'id': technique.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer {{ technique.nom }} ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ technique.id) }}">
    <button class="btn-outline theme-danger">Supprimer</button>
</form>
