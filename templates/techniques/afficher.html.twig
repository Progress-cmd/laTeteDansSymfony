{% extends 'base.html.twig' %}

{% block title %}Techniques{% endblock %}

{% block body %}
    <h1>Techniques</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ technique.id }}</td>
            </tr>
            <tr>
                <th>Nom</th>
                <td>{{ technique.nom }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_techniques') }}" class="btn-text theme-secondary">Retour</a>

    <a href="{{ path('app_modifier_techniques', {'id': technique.id}) }}" class="btn-solid theme-primary">Modifier</a>

    {{ include('techniques/_delete_form.html.twig') }}
{% endblock %}
