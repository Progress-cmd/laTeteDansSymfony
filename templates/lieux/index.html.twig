{% extends 'base.html.twig' %}

{% block title %}Lieux{% endblock %}

{% block body %}
    <h1>Lieux</h1>

    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nom</th>
                <th>Adresse</th>
                <th>Quartier</th>
                <th>Latitude</th>
                <th>Longitude</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for lieux in lieuxes %}
            <tr>
                <td>{{ lieux.id }}</td>
                <td>{{ lieux.nom }}</td>
                <td>{{ lieux.adresse }}</td>
                <td>{{ lieux.quartier }}</td>
                <td>{{ lieux.latitude }}</td>
                <td>{{ lieux.longitude }}</td>
                <td>
                    <a href="{{ path('app_afficher_lieux', {'id': lieux.id}) }}" class="btn-outline theme-secondary btn-sm">Afficher</a>
                    <a href="{{ path('app_modifier_lieux', {'id': lieux.id}) }}" class="btn-solid theme-primary btn-sm">Modifier</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="7">Aucun lieu</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_ajouter_lieux') }}" class="btn-solid theme-primary">Nouveau lieu</a>
{% endblock %}
