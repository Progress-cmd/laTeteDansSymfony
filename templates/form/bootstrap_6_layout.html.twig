{# Thème de formulaire pour Bootstrap 6 (alpha).
   Symfony ne fournit qu'un thème Bootstrap 5 : on le réutilise et on remplace
   seulement les classes qui n'existent plus en v6
   (form-select, form-check, btn-primary, alert-danger, mb-3 -> form-field). #}
{% extends 'bootstrap_5_layout.html.twig' %}

{# Chaque champ : label + widget + erreurs, dans un .form-field #}
{%- block form_row_render -%}
    {%- set row_class = row_class|default(row_attr.class|default('form-field mb-5')|trim) -%}
    {{- parent() -}}
{%- endblock form_row_render %}

{# Les listes déroulantes utilisent .form-control en v6 #}
{%- block choice_widget_collapsed -%}
    {%- set attr = attr|merge({class: (attr.class|default('') ~ ' form-control')|trim}) -%}
    {{- block('choice_widget_collapsed', 'form_div_layout.html.twig') -}}
{%- endblock choice_widget_collapsed -%}

{# Cases à cocher : <input class="check"> suivi de son label, le .form-field fait la mise en page #}
{%- block checkbox_widget -%}
    {%- set attr = attr|merge({class: (attr.class|default('') ~ ' check')|trim}) -%}
    {{- form_label(form, null, {widget: block('checkbox_widget', 'form_div_layout.html.twig')}) -}}
{%- endblock checkbox_widget %}

{%- block radio_widget -%}
    {%- set attr = attr|merge({class: (attr.class|default('') ~ ' radio')|trim}) -%}
    {{- form_label(form, null, {widget: block('radio_widget', 'form_div_layout.html.twig')}) -}}
{%- endblock radio_widget %}

{# Boutons #}
{%- block button_widget -%}
    {%- set attr = attr|merge({class: attr.class|default('btn-outline theme-secondary')}) -%}
    {{- block('button_widget', 'form_div_layout.html.twig') -}}
{%- endblock button_widget %}

{%- block submit_widget -%}
    {%- set type = type|default('submit') -%}
    {%- set attr = attr|merge({class: attr.class|default('btn-solid theme-primary')}) -%}
    {{- block('button_widget', 'form_div_layout.html.twig') -}}
{%- endblock submit_widget %}

{%- block button_row -%}
    <div{% with {attr: row_attr|merge({class: row_attr.class|default('mt-6')|trim})} %}{{ block('attributes') }}{% endwith %}>
        {{- form_widget(form) -}}
    </div>
{%- endblock button_row %}

{# Erreurs globales du formulaire #}
{%- block form_errors -%}
    {%- if errors|length > 0 -%}
        {%- for error in errors -%}
            <div class="{% if form is not rootform %}invalid-feedback{% else %}alert theme-danger mb-5{% endif %} d-block" id="{{ id ~ '_error' ~ loop.index }}">{{ error.message }}</div>
        {%- endfor -%}
    {%- endif %}
{%- endblock form_errors %}
