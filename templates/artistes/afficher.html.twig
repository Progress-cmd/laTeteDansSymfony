{% extends 'base.html.twig' %}

{% block title %}Artistes{% endblock %}

{% block body %}
    <h1>Voir les artistes</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ artiste.id }}</td>
            </tr>
            <tr>
                <th>Pseudonyme</th>
                <td>{{ artiste.pseudonyme }}</td>
            </tr>
            <tr>
                <th>Nom reel</th>
                <td>{{ artiste.nomReel }}</td>
            </tr>
            <tr>
                <th>Bio</th>
                <td>{{ artiste.bio }}</td>
            </tr>
            <tr>
                <th>Nationalité</th>
                <td>{{ artiste.nationalite }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_artistes') }}">Retour</a>

    <a href="{{ path('app_modifier_artistes', {'id': artiste.id}) }}">Modifier</a>

    {{ include('artistes/_delete_form.html.twig') }}
{% endblock %}
